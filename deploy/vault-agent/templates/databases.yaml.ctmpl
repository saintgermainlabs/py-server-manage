{{/*
  Vault Agent template → /etc/server-backup/databases.yaml (0600 root:root).

  Expected KV v2 secrets (one path per DB id):
    secret/data/py-server-manage/backup/databases/<id>
      username  (string)
      password  (string)
      database  (string)  # logical DB name

  Replace COOLIFY_* placeholders below with real container names / UUIDs
  before enabling the agent (non-secret identity fields may stay in git).

  Do not commit a rendered file with real passwords.
*/}}
version: 1
# Generated by Vault Agent — do not edit; change the .ctmpl and KV secrets instead.
databases:
{{- with secret "secret/data/py-server-manage/backup/databases/coolify-db" }}
  - id: coolify-db
    engine: postgresql
    container_name: coolify-db
    coolify_uuid: "COOLIFY_UUID_COOLIFY_DB"
    dump: native
    vault:
      mount: secret
      path: py-server-manage/backup/databases/coolify-db
    credentials:
      user: {{ .Data.data.username | toJSON }}
      password: {{ .Data.data.password | toJSON }}
      name: {{ .Data.data.database | toJSON }}
{{- end }}
{{- with secret "secret/data/py-server-manage/backup/databases/nextcloud-db" }}
  - id: nextcloud-db
    engine: postgresql
    container_name: "nextcloud-db-COOLIFY_SUFFIX"
    coolify_uuid: "COOLIFY_UUID_NEXTCLOUD_DB"
    dump: native
    vault:
      mount: secret
      path: py-server-manage/backup/databases/nextcloud-db
    credentials:
      user: {{ .Data.data.username | toJSON }}
      password: {{ .Data.data.password | toJSON }}
      name: {{ .Data.data.database | toJSON }}
{{- end }}
{{- with secret "secret/data/py-server-manage/backup/databases/app-postgresql-hkg1" }}
  - id: app-postgresql-hkg1
    engine: postgresql
    container_name: "postgresql-COOLIFY_SUFFIX"
    coolify_uuid: "COOLIFY_UUID_POSTGRES_HKG1"
    dump: native
    vault:
      mount: secret
      path: py-server-manage/backup/databases/app-postgresql-hkg1
    credentials:
      user: {{ .Data.data.username | toJSON }}
      password: {{ .Data.data.password | toJSON }}
      name: {{ .Data.data.database | toJSON }}
{{- end }}
{{- with secret "secret/data/py-server-manage/backup/databases/app-mysql-q113" }}
  - id: app-mysql-q113
    engine: mysql
    container_name: "mysql-COOLIFY_SUFFIX"
    coolify_uuid: "COOLIFY_UUID_MYSQL_Q113"
    dump: native
    vault:
      mount: secret
      path: py-server-manage/backup/databases/app-mysql-q113
    credentials:
      user: {{ .Data.data.username | toJSON }}
      password: {{ .Data.data.password | toJSON }}
      name: {{ .Data.data.database | toJSON }}
{{- end }}
{{- with secret "secret/data/py-server-manage/backup/databases/app-postgres-ngty" }}
  - id: app-postgres-ngty
    engine: postgresql
    container_name: "COOLIFY_HASH_CONTAINER"
    coolify_uuid: "COOLIFY_UUID_POSTGRES_NGTY"
    dump: native
    vault:
      mount: secret
      path: py-server-manage/backup/databases/app-postgres-ngty
    credentials:
      user: {{ .Data.data.username | toJSON }}
      password: {{ .Data.data.password | toJSON }}
      name: {{ .Data.data.database | toJSON }}
{{- end }}
{{- with secret "secret/data/py-server-manage/backup/databases/bookstack-mariadb" }}
  - id: bookstack-mariadb
    engine: mariadb
    container_name: "mariadb-COOLIFY_SUFFIX"
    coolify_uuid: "COOLIFY_UUID_MARIADB_BOOKSTACK"
    dump: native
    vault:
      mount: secret
      path: py-server-manage/backup/databases/bookstack-mariadb
    credentials:
      user: {{ .Data.data.username | toJSON }}
      password: {{ .Data.data.password | toJSON }}
      name: {{ .Data.data.database | toJSON }}
{{- end }}
  - id: nextcloud-redis
    engine: redis
    container_name: "redis-COOLIFY_SUFFIX"
    coolify_uuid: "COOLIFY_UUID_NEXTCLOUD_REDIS"
    dump: skip
    vault:
      mount: secret
      path: py-server-manage/backup/databases/nextcloud-redis
    credentials: {}
