TAILSCALE_API_KEY=
COOLIFY_API_KEY=
COOLIFY_URL=
# Aider (https://aider.chat/docs/llms/openrouter.html). Put the real key in .env.local.
OPENROUTER_API_KEY=
# Optional direct Gemini (unused when OpenRouter is configured):
# GEMINI_API_KEY=
# Vault (inventory encrypt/decrypt). Put in .env.local; mise.toml loads .env + .env.local
VAULT_ADDR=https://vault.tiger-bushmaster.ts.net
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=inventory
# AppRole credentials belong only in .env.local (VAULT_ROLE_ID, VAULT_SECRET_ID).
# Optional: VAULT_TOKEN, VAULT_ROLE_ID_FILE, VAULT_SECRET_ID_FILE, VAULT_CACERT,
# VAULT_SKIP_VERIFY.
# Later backup phases (never commit real values):
# BORG_PASSPHRASE, BACKUP_START_URL, BACKUP_SUCCESS_URL, BACKUP_FAILURE_URL,
# HETZNER_BOX_USER, HETZNER_BOX_HOSTNAME
